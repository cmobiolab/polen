source leaprc.protein.ff19SB
source leaprc.water.opc
source leaprc.gaff2
TBB = loadmol2 tbb_anion.mol2
loadamberparams tbb_anion.frcmod
p = loadpdb 6TLL_amber.pdb
l = loadpdb tbb_anion_poseA.pdb
w = loadpdb xwat_anion_poseA.pdb
sys = combine { p l w }
solvateoct sys OPCBOX 12.0
addions sys Na+ 0
addions sys Cl- 0
addionsrand sys Na+ 52 Cl- 52
saveamberparm sys ck2_tbb_anion_poseA.prmtop ck2_tbb_anion_poseA.inpcrd
savepdb sys ck2_tbb_anion_poseA.pdb
quit
