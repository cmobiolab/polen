source leaprc.protein.ff19SB
source leaprc.water.opc
source leaprc.gaff2
BEN = loadmol2 ben.mol2
loadamberparams ben_final.frcmod
p = loadpdb 3PTB_amber.pdb
l = loadpdb ben_xtal.pdb
w = loadpdb xwat.pdb
sys = combine { p l w }
solvateoct sys OPCBOX 12.0
addions sys Na+ 0
addions sys Cl- 0
addionsrand sys Na+ 24 Cl- 24
saveamberparm sys trypsin_ben.prmtop trypsin_ben.inpcrd
savepdb sys trypsin_ben.pdb
quit
